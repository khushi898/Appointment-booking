# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/appointment-booking

# Frontend origin(s) allowed by CORS — comma-separated, no trailing slash
CLIENT_ORIGIN=http://localhost:5173

# JWT — generate a long random secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<long-random-string>
JWT_EXPIRES_IN=1d

# Optional: max auth requests per IP per 15 minutes (default 20)
AUTH_RATE_LIMIT_MAX=20

# Used only by `npm run seed:admin` to create the first admin account
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-admin-password>
