# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/appointment-booking

# Frontend origin(s) allowed by CORS — comma-separated, no trailing slash
CLIENT_ORIGIN=http://localhost:5173
