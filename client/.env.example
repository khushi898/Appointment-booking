# Copy to .env.local for local development. Never commit real env files.
# Only variables starting with VITE_ are exposed to the browser code —
# so never put secrets here; anything in this file is public.

# Base URL of the Express API (no trailing slash)
VITE_API_URL=http://localhost:5000

# ISO currency code used to display prices (e.g. INR, GBP, USD)
VITE_CURRENCY=INR
